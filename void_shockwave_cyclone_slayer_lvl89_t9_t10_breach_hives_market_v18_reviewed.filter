    Class "Life Flasks" "Mana Flasks" "Hybrid Flasks" "Utility Flasks" "Tinctures"
    Quality >= 20
    SetTextColor 220 255 220 230
    SetBorderColor 0 170 100 180
    SetBackgroundColor 0 35 20 150
    SetFontSize 32

Hide
    Class "Life Flasks" "Mana Flasks" "Hybrid Flasks" "Utility Flasks" "Tinctures"

# ---------------------------------------------------------------------
# 9) Divination Cards - calibrado pelos prints do PoE Overlay
# Regra: cartas caras chamam muito; cartas de 5c+ continuam visiveis;
# cartas baixas aparecem discretas para nao poluir Breach/Hives.
