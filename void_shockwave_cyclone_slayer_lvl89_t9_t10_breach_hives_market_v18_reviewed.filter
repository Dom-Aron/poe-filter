# =====================================================================
# Path of Exile 1 - 3.28 Mirage
# VOID Shockwave Cyclone / General's Cry Slayer - Ronarray
# Versao: LVL 89 MAPS T9-T10 - BREACH HIVES - STRICT GEAR / OPEN CURRENCY v18 - REVIEWED
#
# Atualizado para o estado atual do personagem:
# - Anel ja comprado: vida/res/phys/-mana channeling resolvidos.
# - Cinto Stygian + Abyss Jewel comprados: mostrar joias boas continua importante.
# - Rumi's Concoction 12/4 comprado: flasks continuam visiveis, mas sem exagero.
# - Gargalo atual: accuracy/chance to hit e luvas Precursor/accuracy/damage while leeching.
# - Atlas: Breach Hives; Lavish e Mysterious Wombgifts recebem destaque maximo.
# - Economia atualizada pelo print do PoE Overlay: tiers por valor em Chaos; currency baixa ainda visivel, mas sem poluir.
# - Scarabs calibrados pelo print atual: Breach/Hive para uso; scarabs caros para vender/precificar.
# - Divination Cards calibradas pelos prints atuais do PoE Overlay: cartas caras com alerta; cartas baixas visiveis e discretas.
# - v6: adicionadas cartas de 1c-2c enviadas depois, mantendo-as discretas para nao poluir Breach/Hives.
# - v7: adicionados Delirium Orbs/Simulacrum, Legion Emblems/Splinters, fragmentos e Oils calibrados pelos prints atuais.
# - v8: adicionados Catalyst, Omen, Tattoo, Expedition, Harvest/Lifeforce e Runegrafts calibrados pelos prints atuais.
# - v9: adicionados Allflame Embers e Djinn Coins calibrados pelos prints finais do PoE Overlay.
# - v10: corrigido BaseType invalido de Legion: -> usar "Timeless Eternal Emblem".
# - v11: adicionados Essences e Delve/Fossils/Resonators; removidos alguns BaseTypes parciais para evitar erro de parser.
# - v12: corrigido Tattoo de Valako; nome valido: "Tattoo of the Valako Shieldbearer".
# - v13: versao consolidada com Essences e Delve/Fossils/Resonators incluidos.
# - v14: nomes conferidos/corrigidos com PoE Wiki League/itens: Allflame, Djinn Coins e Breach Scarabs; removidos BaseTypes legados/duvidosos.
# - v18: revisado para LVL 89 em mapas T9/T10; removido Cartographer's Chisel (removido em 3.28),
#        movido Hivebrain Gland antes do fallback de Map Fragments, adicionados MirageMap/Imbued,
#        adicionados scarabs novos de Mirage e reclassificadas cartas/omens/runegrafts com mercado atual.
# =====================================================================

# ---------------------------------------------------------------------
# 0) Sempre mostrar itens que o jogo marca como AlwaysShow
# ---------------------------------------------------------------------
Show
    AlwaysShow True
    SetTextColor 120 255 120 255
    SetBorderColor 120 255 120 255
    SetBackgroundColor 0 35 0 220
    SetFontSize 42
    PlayAlertSound 1 200
    MinimapIcon 1 Green Star


# ---------------------------------------------------------------------
# 0.5) OVERRIDE DE MERCADO - PoE Overlay / valores em Chaos
# Coloquei isto antes de Foulborn/Wombgift para itens caros nao cairem
# em uma regra generica. Criterio: destaque pelo valor medio em Chaos.
# ---------------------------------------------------------------------

# T0 - Mega jackpot / itens de valor altissimo ou dificilmente precificados
Show
    BaseType "Mirror of Kalandra" "Hinekora's Lock" "Mirror Shard" "Reflecting Mist"
    SetTextColor 255 255 255 255
    SetBorderColor 255 0 255 255
    SetBackgroundColor 80 0 90 255
    SetFontSize 45
    PlayAlertSound 6 300
    MinimapIcon 0 Purple Star
    PlayEffect Purple

# T1 - Muito alto: geralmente 100c+ no mercado atual
Show
    BaseType "Veiled Exalted Orb" "Orb of Dominance" "Awakener's Orb" "Foulborn Exalted Orb" "Tainted Divine Teardrop" "Volatile Vaal Orb" "Tempering Orb" "Tailoring Orb" "Orb of Conflict" "Crusader's Exalted Orb" "Divine Orb" "Voidborn Reliquary Key" "Fruiting Astrolabe" "Grasping Astrolabe" "Exceptional Eldritch Ember" "Exceptional Eldritch Ichor" "Warlord's Exalted Orb" "Valdo's Puzzle Box" "Hunter's Exalted Orb" "Enshrouded Astrolabe" "Veiled Chaos Orb" "Templar Astrolabe" "Nameless Astrolabe" "Chaotic Astrolabe" "Lightless Astrolabe" "Timeless Astrolabe" "Fungal Astrolabe" "Runic Astrolabe" "Redeemer's Exalted Orb" "Fracturing Orb" "Shaper's Exalted Orb" "Maven's Chisel of Avarice" "Flesh of Xesht" "Elder's Exalted Orb" "Orb of Remembrance"
    SetTextColor 255 255 255 255
    SetBorderColor 255 70 190 255
    SetBackgroundColor 75 0 55 245
    SetFontSize 45
    PlayAlertSound 6 300
    MinimapIcon 0 Purple Star
    PlayEffect Purple

# T2 - Alto/medio-alto: aproximadamente 10c a 100c
Show
    BaseType "Sacred Orb" "Tainted Exalted Orb" "Eldritch Chaos Orb" "Maven's Chisel of Divination" "Eldritch Orb of Annulment" "Foulborn Regal Orb" "Memory of Trauma" "Orb of Annulment" "Memory of Reverence" "Maven's Chisel of Scarab" "Fracturing Shard"
    SetTextColor 255 255 255 255
    SetBorderColor 255 180 0 255
    SetBackgroundColor 75 35 0 240
    SetFontSize 43
    PlayAlertSound 5 250
    MinimapIcon 1 Orange Star
    PlayEffect Orange Temp

# T3 - Medio: vale pegar sempre; bom retorno por slot
Show
    BaseType "Tainted Mythic Orb" "Stacked Deck" "Grand Eldritch Ember" "Maven's Chisel of Procurement" "Orb of Unravelling" "Tainted Orb of Fusing" "Exalted Orb" "Tainted Chaos Orb" "Ancient Orb" "Memory of Loneliness" "Eldritch Exalted Orb" "Foulborn Orb of Augmentation" "Tainted Armourer's Scrap" "Tainted Chromatic Orb" "Gemcutter's Prism"
    SetTextColor 255 245 210 255
    SetBorderColor 230 180 80 255
    SetBackgroundColor 55 35 0 225
    SetFontSize 40
    PlayAlertSound 4 210
    MinimapIcon 2 Yellow Star

# T4 - Baixo, mas util: craft/qualidade/mapas. Visivel e discreto.
Show
    BaseType "Orb of Intention" "Orb of Scouring" "Blessed Orb" "Grand Eldritch Ichor" "Orb of Alchemy" "Tainted Blacksmith's Whetstone" "Armourer's Scrap" "Enkindling Orb" "Tainted Jeweller's Orb" "Glassblower's Bauble" "Greater Eldritch Ember" "Vaal Orb" "Orb of Fusing" "Instilling Orb" "Orb of Regret" "Orb of Chance" "Regal Orb" "Chromatic Orb" "Orb of Augmentation" "Divine Vessel" "Greater Eldritch Ichor" "Orb of Unmaking" "Orb of Alteration" "Lesser Eldritch Ichor" "Blacksmith's Whetstone" "Orb of Binding" "Lesser Eldritch Ember" "Jeweller's Orb"
    SetTextColor 230 230 200 230
    SetBorderColor 180 150 80 190
    SetBackgroundColor 40 30 0 145
    SetFontSize 31
    MinimapIcon 2 Yellow Circle

# T5 - Muito baixo / muita pilha. Aparece minimo; sem som, para nao atrapalhar Breach.
Show
    BaseType "Portal Scroll" "Scroll of Wisdom" "Orb of Transmutation" "Rogue's Marker" "Scroll Fragment" "Transmutation Shard" "Alteration Shard" "Alchemy Shard" "Chaos Shard"
    SetTextColor 150 150 150 180
    SetBorderColor 80 80 80 100
    SetBackgroundColor 15 15 15 65
    SetFontSize 22


# ---------------------------------------------------------------------
# 0.6) OVERRIDE DE MERCADO - Delirium, Legion, Fragments e Oils
# Calibrado pelos prints atuais do PoE Overlay em Chaos.
# Regra: acima de ~80c = alerta forte; 20c-80c = destaque bom;
# abaixo disso = visivel, mas sem poluir o farm de Breach/Hives.
# ---------------------------------------------------------------------

# T0/T1 - Oils, Legion/Fragmentos e especiais muito caros. Sempre precificar.
Show
    BaseType "Tainted Oil" "Syndicate Medallion" "Gift to the Goddess" "The Black Barya" "Unrelenting Timeless Eternal Emblem" "Unrelenting Timeless Maraketh Emblem" "Unrelenting Timeless Templar Emblem" "Unrelenting Timeless Karui Emblem" "Unrelenting Timeless Vaal Emblem" "Echo of Trauma" "Echo of Reverence" "Reality Fragment" "Reverent Fragment" "Fragment of Knowledge" "Echo of Loneliness" "Damnation" "House of Mirrors"
