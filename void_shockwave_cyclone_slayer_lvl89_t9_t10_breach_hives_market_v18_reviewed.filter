    SetTextColor 255 255 255 255
    SetBorderColor 175 96 37 255
    SetBackgroundColor 65 30 5 230
    SetFontSize 43
    PlayAlertSound 5 260
    MinimapIcon 1 Orange Star
    PlayEffect Orange Temp

# Mapas com mecanica especial
Show
    Class "Maps"
    BlightedMap True
    SetTextColor 255 255 255 255
    SetBorderColor 210 120 255 255
    SetBackgroundColor 55 0 80 230
    SetFontSize 42
    PlayAlertSound 5 240
    MinimapIcon 1 Purple Diamond

# Mapas T14+ para farm atual
Show
    Class "Maps"
    MapTier >= 14
    SetTextColor 255 255 255 255
    SetBorderColor 255 160 80 255
    SetBackgroundColor 65 30 0 230
    SetFontSize 42
    PlayAlertSound 4 220
    MinimapIcon 1 Orange Square

# Mapas T11-T13
Show
    Class "Maps"
    MapTier >= 11
    SetTextColor 210 235 255 255
    SetBorderColor 80 160 255 255
    SetBackgroundColor 0 25 55 210
    SetFontSize 38
    MinimapIcon 2 Blue Square

# Mapas T9-T10: progresso atual do personagem; mais visiveis que mapas baixos
Show
    Class "Maps"
    MapTier >= 9
    SetTextColor 210 235 255 245
    SetBorderColor 80 140 220 220
    SetBackgroundColor 0 22 50 185
    SetFontSize 35
    MinimapIcon 2 Blue Square

# Mapas baixos ainda aparecem, mas pequenos, para sustain/completar Atlas
Show
    Class "Maps"
    MapTier >= 1
    SetTextColor 180 210 240 230
    SetBorderColor 70 100 160 180
    SetBackgroundColor 0 15 35 150
    SetFontSize 30
    MinimapIcon 2 Grey Square

# ---------------------------------------------------------------------
# 5) Links, sockets e receitas relevantes
# ---------------------------------------------------------------------

# 6-link: sempre grande
Show
    LinkedSockets >= 6
    SetTextColor 255 255 255 255
    SetBorderColor 255 80 80 255
    SetBackgroundColor 90 0 0 240
    SetFontSize 45
    PlayAlertSound 1 300
    MinimapIcon 0 Red Star
    PlayEffect Red

# 6-socket: valor menor em mapas; visivel, mas sem gritar
Show
    Sockets >= 6
    SetTextColor 230 230 230 230
    SetBorderColor 200 150 60 180
    SetBackgroundColor 45 30 0 140
    SetFontSize 31
    MinimapIcon 2 Yellow Square

# RGB compacto para chromatic; evita poluir inventario com item grande
Show
    SocketGroup RGB
    Width <= 2
    Height <= 3
    SetTextColor 120 190 255 220
    SetBorderColor 0 120 220 180
    SetBackgroundColor 0 20 40 120
    SetFontSize 25

# ---------------------------------------------------------------------
# 6) Gemas: qualidade alta ou suportes importantes da build
# ---------------------------------------------------------------------

# Miragem T1 - gemas Imbued: mostrar mesmo sem qualidade alta
Show
    Class "Skill Gems" "Support Gems"
    Imbued True
    SetTextColor 255 255 255 255
    SetBorderColor 140 230 255 255
    SetBackgroundColor 0 45 70 230
    SetFontSize 41
    PlayAlertSound 4 230
    MinimapIcon 1 Cyan Star
    PlayEffect Cyan Temp

# Suportes centrais para Cyclone fisico / Shockwave / Impale
Show
    Class "Skill Gems" "Support Gems"
    BaseType "Void Shockwave Support" "Shockwave Support" "Impale Support" "Brutality Support" "Melee Physical Damage Support" "Infused Channelling Support" "Increased Critical Damage Support" "Increased Critical Strikes Support" "Faster Attacks Support" "Pulverise Support" "Fortify Support" "General's Cry" "Greater Multistrike Support" "Greater Ancestral Call Support" "Fissure Support"
    SetTextColor 255 255 255 255
    SetBorderColor 80 255 230 255
    SetBackgroundColor 0 55 55 230
    SetFontSize 40
    PlayAlertSound 4 230
    MinimapIcon 2 Cyan Circle

# 20% qualidade: pegar para venda/upgrade/receita
Show
    Class "Skill Gems" "Support Gems"
    Quality >= 20
    SetTextColor 255 255 255 255
    SetBorderColor 0 255 255 255
    SetBackgroundColor 0 65 65 235
    SetFontSize 42
    PlayAlertSound 5 240
    MinimapIcon 1 Cyan Star
    PlayEffect Cyan Temp

# Qualidade alta: voce esta lvl 90+, entao quality baixa fica escondida
Show
    Class "Skill Gems" "Support Gems"
    Quality >= 15
    SetTextColor 27 220 200 255
    SetBorderColor 180 255 245 255
    SetBackgroundColor 0 45 45 220
    SetFontSize 37
    PlayAlertSound 3 180
    MinimapIcon 2 Cyan Circle

Hide
    Class "Skill Gems" "Support Gems"

# ---------------------------------------------------------------------
# 7) Unicos
# ---------------------------------------------------------------------

# Unicos de classes muito relevantes para a build/mercado: chamam atencao
Show
    Rarity Unique
    Class "Staves" "Warstaves" "Helmets" "Boots" "Belts" "Rings" "Amulets" "Utility Flasks" "Jewels" "Abyss Jewels"
    SetTextColor 255 255 255 255
    SetBorderColor 255 150 50 255
    SetBackgroundColor 80 35 0 230
    SetFontSize 42
    PlayAlertSound 5 260
    MinimapIcon 1 Orange Star
    PlayEffect Orange Temp

# Outros unicos ainda aparecem, mas sem exagero
Show
    Rarity Unique
    SetTextColor 230 190 130 255
    SetBorderColor 150 90 35 220
    SetBackgroundColor 45 25 10 170
    SetFontSize 32

# ---------------------------------------------------------------------
# 8) Frascos: estrito, mas atento a flasks da build
# ---------------------------------------------------------------------

# Rumi's e flasks unicos bons ja aparecem na regra de unicos, mas reforcamos flasks de utility relevantes
Show
    Class "Utility Flasks"
    BaseType "Granite Flask" "Diamond Flask" "Silver Flask" "Quicksilver Flask"
    Quality >= 20
    SetTextColor 255 255 255 255
    SetBorderColor 0 255 130 255
    SetBackgroundColor 0 55 25 230
    SetFontSize 38
