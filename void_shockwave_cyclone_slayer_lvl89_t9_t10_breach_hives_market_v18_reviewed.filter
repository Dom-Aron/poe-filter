# ---------------------------------------------------------------------
# 10) Bases raras/craft alinhadas com Cyclone fisico + block por staff
# ---------------------------------------------------------------------

# Staff de endgame: sua staff ja e boa; mostrar so bases realmente relevantes
Show
    BaseType "Judgement Staff" "Foul Staff" "Ezomyte Staff"
    ItemLevel >= 82
    Rarity <= Rare
    SetTextColor 255 255 119 255
    SetBorderColor 255 220 80 255
    SetBackgroundColor 55 45 0 210
    SetFontSize 37
    MinimapIcon 2 Yellow Diamond

# Luvas agora sao prioridade de compra/craft: accuracy, life, attack speed, damage while leeching
Show
    BaseType "Precursor Gauntlets" "Leviathan Gauntlets" "Titan Gauntlets" "Slink Gloves"
    ItemLevel >= 84
    Rarity Rare
    SetTextColor 255 255 119 255
    SetBorderColor 255 210 80 255
    SetBackgroundColor 60 45 0 220
    SetFontSize 39
    PlayAlertSound 2 170
    MinimapIcon 2 Yellow Diamond

# Armadura/capacete/botas defensivos alinhados com armour/life
Show
    BaseType "Astral Plate" "Crusader Plate" "Ezomyte Burgonet" "Gladiator Helmet" "Titan Greaves" "Hydrascale Boots"
    ItemLevel >= 84
    Rarity <= Rare
    SetTextColor 255 255 119 255
    SetBorderColor 190 190 80 255
    SetBackgroundColor 45 45 15 190
    SetFontSize 35

# Acessorios agora menos prioritarios; ainda aparecem para venda/craft, mas sem alerta alto
Show
    BaseType "Stygian Vise" "Rustic Sash" "Amethyst Ring" "Two-Stone Ring" "Lapis Amulet" "Turquoise Amulet" "Citrine Amulet" "Onyx Amulet"
    ItemLevel >= 82
    Rarity Rare
    SetTextColor 255 255 119 245
    SetBorderColor 190 100 190 220
    SetBackgroundColor 40 0 40 170
    SetFontSize 34

# Fractured nas bases certas: prioridade para craft/venda
Show
    BaseType "Judgement Staff" "Foul Staff" "Ezomyte Staff" "Astral Plate" "Crusader Plate" "Precursor Gauntlets" "Leviathan Gauntlets" "Titan Gauntlets" "Slink Gloves" "Ezomyte Burgonet" "Gladiator Helmet" "Titan Greaves" "Hydrascale Boots" "Stygian Vise" "Rustic Sash" "Amethyst Ring" "Two-Stone Ring" "Lapis Amulet" "Turquoise Amulet" "Citrine Amulet" "Onyx Amulet"
    ItemLevel >= 80
    FracturedItem True
    SetTextColor 255 255 255 255
    SetBorderColor 255 120 255 255
    SetBackgroundColor 65 0 65 220
    SetFontSize 40
    PlayAlertSound 5 230
    MinimapIcon 1 Purple Diamond
    PlayEffect Purple Temp

# Synthesised em joias/acessorios e bases da build
Show
    BaseType "Stygian Vise" "Rustic Sash" "Amethyst Ring" "Two-Stone Ring" "Lapis Amulet" "Turquoise Amulet" "Citrine Amulet" "Onyx Amulet" "Judgement Staff" "Foul Staff" "Ezomyte Staff" "Precursor Gauntlets"
    SynthesisedItem True
    SetTextColor 255 255 255 255
    SetBorderColor 120 220 255 255
    SetBackgroundColor 0 45 65 220
    SetFontSize 39
    PlayAlertSound 4 220
    MinimapIcon 1 Cyan Diamond

# Cluster jewels: foco em Large Physical 8 passivas via trade, mas mostrar todos para venda/craft
