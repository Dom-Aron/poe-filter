# ---------------------------------------------------------------------
# 1) Drops especiais / liga / Breach Hives
# ---------------------------------------------------------------------

# Foulborn: especiais da mecanica atual
Show
    Foulborn True
    SetTextColor 255 255 255 255
    SetBorderColor 255 110 255 255
    SetBackgroundColor 75 0 75 235
    SetFontSize 44
    PlayAlertSound 6 280
    MinimapIcon 1 Purple Hexagon
    PlayEffect Purple Temp

# Breach Hives - melhor escolha para farm de currency/valor variado
# Lavish = currency; Mysterious = recompensas variadas. Destaque maximo.
Show
    Class "Wombgifts"
    BaseType "Lavish Wombgift" "Mysterious Wombgift"
    SetTextColor 255 255 255 255
    SetBorderColor 80 255 180 255
    SetBackgroundColor 0 80 45 245
    SetFontSize 45
    PlayAlertSound 6 300
    MinimapIcon 0 Green Star
    PlayEffect Green

# Ancient/Provisioning ainda aparecem bem, mas abaixo de Lavish/Mysterious.
Show
    Class "Wombgifts"
    BaseType "Ancient Wombgift" "Provisioning Wombgift"
    SetTextColor 230 255 230 255
    SetBorderColor 80 210 150 255
    SetBackgroundColor 0 55 35 230
    SetFontSize 42
    PlayAlertSound 4 240
    MinimapIcon 1 Green Diamond
    PlayEffect Green Temp

# Fallback: qualquer Wombgift nao listado acima
