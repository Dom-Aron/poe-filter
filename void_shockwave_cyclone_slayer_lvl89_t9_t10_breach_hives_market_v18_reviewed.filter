Show
    BaseType "Medium Cluster Jewel" "Small Cluster Jewel"
    ItemLevel >= 75
    SetTextColor 220 235 255 245
    SetBorderColor 90 140 220 220
    SetBackgroundColor 0 25 50 170
    SetFontSize 34

# Joias raras e Abyss: continuam importantes para life/accuracy/phys/res/attributes
Show
    Class "Jewels" "Abyss Jewels"
    Rarity Rare
    ItemLevel >= 75
    SetTextColor 255 255 119 255
    SetBorderColor 130 130 255 255
    SetBackgroundColor 20 20 60 180
    SetFontSize 35

