    Class "Wombgifts"
    SetTextColor 220 255 230 255
    SetBorderColor 80 190 140 255
    SetBackgroundColor 0 45 30 220
    SetFontSize 40
    PlayAlertSound 3 210
    MinimapIcon 1 Green Circle


# ---------------------------------------------------------------------
# 1.5) SCARABS - calibrado pelo PoE Overlay atual + farm Breach Hives
# Regra: scarabs de Breach/Hive aparecem mesmo quando baratos, porque voce provavelmente usa.
# Scarabs muito caros aparecem com alerta forte para vender/precificar, nao jogar fora.
# ---------------------------------------------------------------------

# Breach Resonant Cascade: no print esta caro (~83c). Nao consumir sem calcular ROI.
Show
    Class "Map Fragments"
    BaseType "Breach Scarab of Resonant Cascade"
    SetTextColor 255 255 255 255
    SetBorderColor 80 255 255 255
    SetBackgroundColor 0 70 90 245
    SetFontSize 45
    PlayAlertSound 6 300
    MinimapIcon 0 Cyan Star
    PlayEffect Cyan

# Core do seu farm: manter destacado mesmo se o valor unitario for baixo.
# PoE Wiki 3.28 lista Hive, Instability, Marshal, Incensed Swarm e Resonant Cascade; removi "Breach Scarab" legado e "Dreamer" duvidoso.
Show
    Class "Map Fragments"
    BaseType "Breach Scarab of the Hive" "Breach Scarab of Instability" "Breach Scarab of the Incensed Swarm" "Breach Scarab of the Marshal"
    SetTextColor 230 255 255 255
    SetBorderColor 90 220 255 255
    SetBackgroundColor 0 45 75 235
    SetFontSize 41
    PlayAlertSound 4 220
    MinimapIcon 1 Cyan Diamond
    PlayEffect Cyan Temp

# Scarabs jackpot / valor muito alto no print atual.
Show
    Class "Map Fragments"
    BaseType "Horned Scarab of Bloodlines" "Horned Scarab of Preservation" "Ambush Scarab of Containment" "Harvest Scarab of Cornucopia"
