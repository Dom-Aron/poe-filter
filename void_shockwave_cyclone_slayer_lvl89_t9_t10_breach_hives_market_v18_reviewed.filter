    BaseType "Divine Life Flask" "Eternal Life Flask"
    Quality >= 20
    SetTextColor 255 255 255 255
    SetBorderColor 0 220 120 255
    SetBackgroundColor 0 45 25 210
    SetFontSize 36
    MinimapIcon 2 Green Circle

